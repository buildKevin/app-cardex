# Copy to .env — every key is optional.
# Without any key the app runs fully offline in demo mode (mocked scans, mocked purchase).

# Supabase — enables auth, cloud garage sync and the identify-car edge function
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Vision — leave empty to call the Supabase edge function instead (recommended).
# Only use this for local dev: a key shipped in the bundle is readable by anyone.
EXPO_PUBLIC_OPENAI_API_KEY=

# RevenueCat
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# PostHog
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
