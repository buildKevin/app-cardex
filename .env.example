# Copy to .env — every key is optional.
# Without any key the app runs fully offline in demo mode (mocked scans, mocked purchase).

# Supabase — enables auth, cloud garage sync and the identify-car edge function
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Vision — leave empty to call the Supabase edge function instead (recommended).
# Only use this for local dev: a key shipped in the bundle is readable by anyone.
EXPO_PUBLIC_OPENAI_API_KEY=

# RevenueCat — store keys, one per platform. These are what ships.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Test Store key (test_…). Works on every platform at once and lets you buy
# CarDex Pro without App Store Connect or the Play Console. Takes priority over
# the two keys above whenever it is set, so leave it empty to test the real
# store. `npm run verify:release` refuses to build production with it.
EXPO_PUBLIC_REVENUECAT_TEST_KEY=

# Entitlement identifier as spelled in the RevenueCat dashboard.
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT=cardex_pro

# PostHog — analytics, error tracking, feature flags et surveys.
# La clé `phc_…` est publique par conception (elle ne peut qu'écrire des events).
# Laisser vide désactive tout : `disabled` est passé au SDK, donc chaque appel
# reste sans effet et l'app tourne exactement comme avant.
EXPO_PUBLIC_POSTHOG_KEY=
# EU ou US selon le projet — se tromper envoie les events dans le vide sans erreur.
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Mettre à 1 pour utiliser le paywall dessiné dans le dashboard RevenueCat au
# lieu de l'écran de l'app. Laisser vide : les gabarits RevenueCat ne rendent
# pas la direction artistique, et un dashboard sans paywall configuré affiche
# « There's no paywall configured » à l'utilisateur.
EXPO_PUBLIC_USE_REVENUECAT_UI=
