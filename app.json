{
  "expo": {
    "name": "CarDex",
    "slug": "carspot",
    "version": "1.0.0",
    "scheme": "cardex",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.buildkevin.cardex",
      "infoPlist": {
        "NSCameraUsageDescription": "CarDex utilise l'appareil photo pour identifier les voitures que tu scannes.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.buildkevin.cardex",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-font",
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "CarDex utilise l'appareil photo pour identifier les voitures que tu scannes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CarDex accède à tes photos pour que tu puisses choisir ta photo de profil.",
          "cameraPermission": "CarDex utilise l'appareil photo pour identifier les voitures que tu scannes.",
          "microphonePermission": false
        }
      ],
      "expo-web-browser",
      [
        "expo-media-library",
        {
          "savePhotosPermission": "CarDex enregistre tes stickers dans ta galerie photo quand tu le demandes."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0fd76e9b-321e-4509-922f-b6c0a5637cd2"
      }
    },
    "owner": "buildkevin"
  }
}
